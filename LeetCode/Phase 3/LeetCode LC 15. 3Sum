class Solution:
    def threeSum(self, nums: list[int]) -> list[list[int]]:
        new_num = sorted(nums)
        result = []

        if not new_num:
            return []

        for i in range(len(new_num)):
            if i > 0 and new_num[i] == new_num[i - 1]:
                continue
            left = i + 1
            right = len(new_num) - 1
            while left < right:
                total = new_num[i] + new_num[left] + new_num[right]
                if total == 0:
                    result.append([new_num[i], new_num[left],new_num[right]])
                    left += 1
                    right -= 1
                    while left < right and new_num[left] == new_num[left - 1]:
                        left += 1
                elif total < 0:
                    left += 1
                else:
                    right -= 1
        return result
