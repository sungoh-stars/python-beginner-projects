class Solution:
    def insert(self, intervals: list[list[int]], newInterval: list[int]) -> list[list[int]]:
        if not intervals:
            return [newInterval]

        total = []

        new = sorted(intervals + [newInterval])
        now = new[0]

        for next1 in new[1:]:
            if now[1] >= next1[0]:
                now[1] = max(now[1], next1[1])
            else:
                total.append(now)
                now = next1
        total.append(now)
        return total
