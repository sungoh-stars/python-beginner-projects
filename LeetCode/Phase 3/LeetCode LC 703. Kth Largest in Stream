import heapq
class KthLargest:

    def __init__(self, k: int, nums: list[int]):
        self.result = []
        for i in nums:
            heapq.heappush(self.result, i)
        self.k = k

    def add(self, val: int) -> int:
        heapq.heappush(self.result,val)
        while len(self.result) > self.k:
            heapq.heappop(self.result)
        return self.result[0]

