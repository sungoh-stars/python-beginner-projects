class Solution:
    def merge(self, intervals: list[list[int]]) -> list[list[int]]:

        if not intervals:
            return []
        total = []

        intervals.sort()

        now = intervals[0]

        for n in intervals[1:]:
            if now[1] >= n[0]:
                now[1] = max(now[1], n[1])
            else:
                total.append(now)
                now = n
        total.append(now)
        return total
