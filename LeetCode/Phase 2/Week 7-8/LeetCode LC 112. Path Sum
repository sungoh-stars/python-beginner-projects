# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def hasPathSum(self, root: TreeNode | None, targetSum: int, total=0) -> bool:
        if root is None:
            return False
        
        new_total = total + root.val

        left = self.hasPathSum(root.left,targetSum,new_total)
        right = self.hasPathSum(root.right,targetSum,new_total)

        if root.left is None and root.right is None and new_total == targetSum:
            return True
        return left or right
