def day_43(head):
    slow = head
    fast = head
    keword = None

    while fast.next != None and fast.next.next != None:
        slow = slow.next
        fast = fast.next.next

    num = slow.next
    slow.next = keword

    curr = num
    prev = None

    while curr != None:
        total = curr.next
        curr.next = prev

        prev = curr
        curr = total

    p1 = head
    p2 = prev

    while p2 != None:
        temp1 = p1.next
        temp2 = p2.next

        p1.next = p2
        p2.next = temp1

        p1 = temp1
        p2 = temp2

    return head
