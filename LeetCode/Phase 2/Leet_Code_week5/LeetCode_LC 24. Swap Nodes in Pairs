class Solution:
    def swapPairs(self, head: Optional[ListNode]) -> Optional[ListNode]:
        dummy = ListNode(0)
        prev = dummy
        dummy.next = head
        num1 = head
        num2 = num1.next if num1 else None

        while num1 != None and num2 != None:
            total = num2.next
            num2.next = num1
            num1.next = total
            prev.next = num2
            prev = num1

            num1 = total
            num2 = num1.next if num1 else None
        return dummy.next
