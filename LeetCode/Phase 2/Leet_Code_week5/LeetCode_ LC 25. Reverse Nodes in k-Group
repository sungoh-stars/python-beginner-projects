# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def reverseKGroup(self, head: Optional[ListNode], k: int) -> Optional[ListNode]:
        curr = head
        prev = None
        count = 0

        while curr != None and count < k:
            count += 1
            curr = curr.next

        if count < k:
            return head

        curr = head
        
        for i in range(k):
            total = curr.next
            curr.next = prev

            prev = curr
            curr = total

        head.next = self.reverseKGroup(curr, k)
        return prev
